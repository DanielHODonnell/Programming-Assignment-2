<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="410.0" prefWidth="352.0" spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.menu.MenuController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <HBox prefHeight="55.0" prefWidth="312.0" stylesheets="@style.css">
         <children>
            <Label prefHeight="106.0" prefWidth="313.0" text="Burger Creator" textAlignment="CENTER">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <Accordion>
        <panes>
          <TitledPane animated="false" text="Buns">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <RadioButton fx:id="rbSesame" mnemonicParsing="false" text="Sesame seed - $2.00">
                           <toggleGroup>
                              <ToggleGroup fx:id="bun" />
                           </toggleGroup>
                           <font>
                              <Font size="18.0" />
                           </font></RadioButton>
                        <RadioButton fx:id="rbBrioche" layoutY="27.0" mnemonicParsing="false" text="Brioche - $2.50" toggleGroup="$bun">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </RadioButton>
                     </children></AnchorPane>
            </content>
               <font>
                  <Font size="18.0" />
               </font>
          </TitledPane>
          <TitledPane animated="false" prefHeight="235.0" prefWidth="312.0" text="Cheese">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="411.0" prefWidth="200.0">
                     <children>
                        <CheckBox fx:id="cbCheddar" mnemonicParsing="false" prefHeight="27.0" prefWidth="312.0" text="Cheddar - $0.50">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </CheckBox>
                        <CheckBox fx:id="cbAmerican" layoutY="26.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="312.0" text="American - $0.50">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </CheckBox>
                        <CheckBox fx:id="cbSwiss" layoutY="52.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="312.0" text="Swiss - $0.75">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </CheckBox>
                        <CheckBox fx:id="cbPepper" layoutY="78.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="312.0" text="Pepper Jack - $1.00">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </CheckBox>
                     </children></AnchorPane>
            </content>
               <font>
                  <Font size="18.0" />
               </font>
          </TitledPane>
            <TitledPane animated="false" text="Garnishes">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <CheckBox fx:id="cbLettuce" mnemonicParsing="false" prefHeight="27.0" prefWidth="312.0" text="Lettuce - $0.10">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </CheckBox>
                        <CheckBox fx:id="cbTomato" layoutY="52.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="312.0" text="Tomato - $0.25">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </CheckBox>
                        <CheckBox fx:id="cbBacon" layoutY="78.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="312.0" text="Bacon - $1.00">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </CheckBox>
                        <CheckBox fx:id="cbOnion" layoutY="26.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="312.0" text="Onion - $0.15">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </CheckBox>
                     </children>
                  </AnchorPane>
              </content>
               <font>
                  <Font size="18.0" />
               </font>
            </TitledPane>
          <TitledPane animated="false" text="Patty">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <RadioButton fx:id="rbNonVeg" mnemonicParsing="false" prefHeight="27.0" prefWidth="312.0" text="Non-Vegetarian - $1.00">
                           <toggleGroup>
                              <ToggleGroup fx:id="patty" />
                           </toggleGroup>
                           <font>
                              <Font size="18.0" />
                           </font>
                        </RadioButton>
                        <RadioButton fx:id="rbVeg" layoutY="55.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="312.0" text="Vegetarian - $1.50" toggleGroup="$patty">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </RadioButton>
                        <RadioButton fx:id="rbImpossible" layoutY="27.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="312.0" text="Impossible - $0.75">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </RadioButton>
                        <RadioButton fx:id="rbChicken" layoutY="82.0" mnemonicParsing="false" prefHeight="24.0" prefWidth="312.0" text="Chicken - $1.00">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </RadioButton>
                     </children></AnchorPane>
            </content>
               <font>
                  <Font size="18.0" />
               </font>
          </TitledPane>
        </panes>
      </Accordion>
      <HBox prefHeight="1.0" prefWidth="312.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onClickPriceDisplay" prefHeight="31.0" prefWidth="75.0" text="Done">
               <font>
                  <Font size="15.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#onClickReset" prefHeight="31.0" prefWidth="79.0" text="Reset">
               <font>
                  <Font size="15.0" />
               </font>
            </Button>
            <Label prefHeight="43.0" prefWidth="55.0" text=" Price: ">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Label fx:id="getPrice" prefHeight="46.0" prefWidth="102.0">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </children>
</VBox>
